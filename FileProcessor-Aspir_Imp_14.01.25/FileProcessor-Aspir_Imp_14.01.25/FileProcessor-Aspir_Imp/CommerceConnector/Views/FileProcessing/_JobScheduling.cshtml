@{
}

<div class="job-scheduler-container">
    <h2>Job Scheduling</h2>
    <p>
        Use this form to schedule jobs for execution:
    </p>
    <ul>
        <li>
            <strong>One Time Job:</strong> Enter the datetime in the format <code>yyyy-MM-ddTHH:mm</code>. Example: <code>2024-12-05T11:30</code>.
        </li>
        <li>
            <strong>Recurring Job:</strong> Provide a valid <em>Cron Expression</em> to define a recurring schedule.
            A Cron Expression is a string consisting of six fields (seconds, minutes, hours, day of month, month, day of week) separated by spaces.
            For example: <code>0 0 * * *</code> runs the job daily at midnight.
            <a href="https://crontab.guru/" target="_blank" rel="noopener">Learn more about Cron Expressions</a>.
        </li>
    </ul>

    <label for="jobSchedule">Job Schedule</label>
    <select id="jobSchedule">
        <option value="" disabled selected>Select Job Type</option>
        <option value="oneTime">One Time</option>
        <option value="recurring">Recurring</option>
    </select>

    <div id="jobTimeDiv" style="display: none;">
        <label for="jobTime">Job Time</label>
        <input type="text" id="jobTime" placeholder="Enter time in yyyy-MM-ddTHH:mm format" />
    </div>

    <div id="cronExpressionDiv" style="display: none;">
        <label for="cronExpression">Cron Expression</label>
        <input type="text" id="cronExpression" placeholder="Enter Cron Expression" />
    </div>

    <button id="jobScheduleButton">Submit</button>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    $('#jobSchedule').on('change', function () {
        var selectedValue = $(this).val();
        if (selectedValue === "oneTime") {
            $('#jobTimeDiv').show();
            $('#cronExpressionDiv').hide();
        } else if (selectedValue === "recurring") {
            $('#cronExpressionDiv').show();
            $('#jobTimeDiv').hide();
        }
    });

    $('#jobScheduleButton').on('click', function () {
        const jobSchedule = $('#jobSchedule').val();
        const jobTime = $('#jobTime').val();
        const cronExpression = $('#cronExpression').val();

        $.ajax({
            url: '/Jobs/Schedule',
            method: 'POST',
            data: {
                jobSchedule: jobSchedule,
                jobTime: jobTime,
                cronExpression: cronExpression
            },
            success: function (response) {
                alert(response);
            },
            error: function () {
                alert('Error scheduling job.');
            }
        });
    });
</script>

