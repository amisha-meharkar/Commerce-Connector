        }

        .job-scheduler-container p {
            font-size: 14px;
            color: #555;
        }

        .job-scheduler-container ul {
            font-size: 14px;
            margin-bottom: 20px;
            color: #333;
            padding-left: 20px;
        }

            .job-scheduler-container ul li {
                margin-bottom: 10px;
            }

        .job-scheduler-container label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #333;
        }

        .job-scheduler-container select,
        .job-scheduler-container input {
            width: 100%;
            padding: 8px;
            margin-bottom: 16px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }

        .job-scheduler-container button {
